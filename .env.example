# =============================================================
# SISTEMA DE FACTURACIÓN - EMPRESA DE INFORMÁTICA PUCALLPA
# Archivo de configuración de entorno (.env)
# Copiar este archivo como .env y completar los valores
# =============================================================

# -----------------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# -----------------------------------------------
APP_NAME="Sistema de Facturación - Pucallpa"
APP_URL=http://localhost:8080
APP_ENV=development
APP_DEBUG=true
# Clave secreta de la aplicación (generar con: php -r "echo bin2hex(random_bytes(32));")
APP_KEY=cambiar_por_clave_secreta_de_64_caracteres_hex

# -----------------------------------------------
# BASE DE DATOS MySQL/MariaDB
# -----------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=facturacion_pucallpa
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# -----------------------------------------------
# CONFIGURACIÓN DE CORREO (SMTP)
# -----------------------------------------------
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@tuempresa.com
MAIL_PASSWORD=tu_contraseña_smtp
MAIL_FROM_ADDRESS=noreply@tuempresa.com
MAIL_FROM_NAME="Sistema de Facturación Pucallpa"
MAIL_ENCRYPTION=tls

# -----------------------------------------------
# CONFIGURACIÓN SUNAT (FACTURACIÓN ELECTRÓNICA)
# -----------------------------------------------
# RUC de la empresa emisora
SUNAT_RUC=20XXXXXXXXX
# Usuario SOL (RUC + usuario, ej: 20XXXXXXXXX + USUARIO)
SUNAT_USUARIO_SOL=MODDATOS
# Clave SOL del usuario
SUNAT_CLAVE_SOL=moddatos
# Modo de operación: beta | produccion
SUNAT_MODO=beta
# Ruta al certificado digital (.pem o .p12)
SUNAT_CERT_PATH=storage/certificados/certificado.pem
# Contraseña del certificado digital
SUNAT_CERT_PASS=

# -----------------------------------------------
# TIPO DE CAMBIO (REFERENCIAL)
# -----------------------------------------------
# Tipo de cambio USD → PEN (actualizar diariamente)
TIPO_CAMBIO_USD=3.85

# Ubicación que abrirá el QR de los comprobantes (coordenadas de Google Maps)
# Ejemplo: -8.379147 y -74.553867
EMPRESA_LATITUD=-8.384511
EMPRESA_LONGITUD=-74.570291

# API Decolecta para consultar DNI y RUC desde el POS
DECOLECTA_TOKEN=

# -----------------------------------------------
# CONFIGURACIÓN DE LOGS
# -----------------------------------------------
LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

# -----------------------------------------------
# CONFIGURACIÓN DE SESIÓN
# -----------------------------------------------
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTPONLY=true

# -----------------------------------------------
# CONFIGURACIÓN DE ARCHIVOS
# -----------------------------------------------
STORAGE_PATH=storage
UPLOAD_MAX_SIZE=5242880
